# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
/.pnpm-store

# testing
/coverage

# next.js
/.next/
/out/

# Next.js-generated types belong in .next/, not the source types directory.
/types/validator.ts
/types/routes.d.ts
/types/cache-life.d.ts
/types/root-params.d.ts

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

#claude
.claude/settings.local.json

# CodeRabbit local review artifacts (scripts/cr-agent.sh)
/.coderabbit/review.ndjson
/.coderabbit/review.tmp.*
/.coderabbit/stale/
